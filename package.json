{
  "name": "@cyanism/pi-toolbelt",
  "version": "0.1.1",
  "description": "Progressive tool discovery for Pi — carry only the tools you need",
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyanistic/pi-toolbelt.git"
  },
  "homepage": "https://github.com/Cyanistic/pi-toolbelt#readme",
  "bugs": {
    "url": "https://github.com/Cyanistic/pi-toolbelt/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "tool-search",
    "dynamic-tools"
  ],
  "author": "Cyanism",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format --write src package.json tsconfig.json biome.json",
    "fix": "biome check --write src package.json tsconfig.json biome.json",
    "check": "biome check src package.json tsconfig.json biome.json && tsc --noEmit",
    "changelog:preview": "git-cliff --unreleased",
    "release:prepare": "node scripts/release-prepare.mjs"
  },
  "dependencies": {
    "minisearch": "^7.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.7",
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "@earendil-works/pi-tui": ">=0.80.7",
    "typebox": ">=1.1.38 <2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": ">=0.80.7",
    "@types/node": "^20.0.0",
    "git-cliff": "2.13.1",
    "semver": "7.8.5",
    "tsx": "^4.23.1",
    "typebox": "1.1.38",
    "typescript": "^5.5.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
